# Required: a dedicated secret shared only by upnext-be and upnext-ai.
# Generate with a cryptographically secure password generator; never reuse JWT_ACCESS_SECRET.
AI_INTERNAL_JWT_SECRET=<at-least-32-random-characters>

# development | staging | production. The BE-issued internal token must match it.
AI_ENVIRONMENT=development
AI_INTERNAL_JWT_ISSUER=upnext-be
AI_INTERNAL_JWT_AUDIENCE=upnext-ai
AI_INTERNAL_JWT_MAX_TTL_SECONDS=90

# Gemini is intentionally optional at boot. /health/ready returns 503 until it is configured.
GEMINI_API_KEY=
AI_STRUCTURED_MODEL=gemini-2.5-flash-lite
AI_TEXT_MODEL=gemini-2.5-flash
AI_STRUCTURED_TIMEOUT_SECONDS=15
AI_STREAM_TIMEOUT_SECONDS=20
# Optional trusted OTLP HTTP endpoint (for example, http://otel-collector:4318/v1/traces).
# Leave empty to keep traces in-process and prevent any prompt metadata from reaching logs.
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
